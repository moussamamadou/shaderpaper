{
  "$description": "ShaderPaper storefront design tokens v1. Single source for Figma variables (collection 'SP / Tokens v1') and the Nuxt Tailwind theme (apps/storefront/tailwind.config.ts). Change here first, then both.",
  "color": {
    "paper": "#F5F3EF",
    "surface": "#FFFFFF",
    "sunken": "#ECE9E3",
    "ink": "#111111",
    "ink-2": "#4A4946",
    "ink-3": "#6B6964",
    "line": "#DAD6CF",
    "line-strong": "#B5AFA5",
    "night": "#0E0E10",
    "night-2": "#1B1B1F",
    "on-night": "#F5F3EF",
    "on-night-2": "#A9A6A0",
    "signal": "#F0441A",
    "on-signal": "#111111",
    "success": "#1E7A46",
    "success-bg": "#E3F1E8",
    "warning": "#8A5A00",
    "warning-bg": "#FBEFD6",
    "danger": "#B3261E",
    "danger-bg": "#F9E2DF",
    "info": "#2450B2",
    "info-bg": "#E2E9F8",
    "frame-black": "#161616",
    "frame-white": "#F7F7F5",
    "frame-oak": "#C49A6C",
    "scrim": "rgba(14,14,16,0.48)"
  },
  "font": {
    "sans": "Geist",
    "mono": "Geist Mono"
  },
  "type": {
    "display-xl": { "family": "sans", "weight": 600, "size": 88, "line": 88, "tracking": -3, "mobile": { "size": 48, "line": 50 } },
    "display-l": { "family": "sans", "weight": 600, "size": 64, "line": 66, "tracking": -2.5, "mobile": { "size": 40, "line": 44 } },
    "h1": { "family": "sans", "weight": 600, "size": 44, "line": 48, "tracking": -2, "mobile": { "size": 32, "line": 36 } },
    "h2": { "family": "sans", "weight": 600, "size": 30, "line": 36, "tracking": -1.5, "mobile": { "size": 24, "line": 30 } },
    "h3": { "family": "sans", "weight": 500, "size": 20, "line": 28, "tracking": -0.5 },
    "body-l": { "family": "sans", "weight": 400, "size": 18, "line": 28, "tracking": 0 },
    "body": { "family": "sans", "weight": 400, "size": 16, "line": 24, "tracking": 0 },
    "body-s": { "family": "sans", "weight": 400, "size": 14, "line": 20, "tracking": 0 },
    "label": { "family": "mono", "weight": 500, "size": 12, "line": 16, "tracking": 6, "case": "upper" },
    "caption": { "family": "mono", "weight": 400, "size": 11, "line": 14, "tracking": 4, "case": "upper" },
    "price": { "family": "sans", "weight": 500, "size": 18, "line": 24, "tracking": 0, "numeric": "tabular" },
    "button": { "family": "sans", "weight": 500, "size": 15, "line": 20, "tracking": 0 }
  },
  "space": [0, 2, 4, 8, 12, 16, 20, 24, 32, 40, 48, 64, 80, 96, 128],
  "radius": { "none": 0, "xs": 2, "sm": 4, "pill": 999 },
  "shadow": {
    "poster": "0 1px 2px rgba(17,17,17,0.08), 0 16px 32px -12px rgba(17,17,17,0.28)",
    "overlay": "0 24px 64px rgba(17,17,17,0.18)",
    "focus": "0 0 0 2px #F5F3EF, 0 0 0 4px #F0441A"
  },
  "grid": {
    "desktop": { "frame": 1440, "columns": 12, "margin": 48, "gutter": 24 },
    "tablet": { "frame": 834, "columns": 8, "margin": 32, "gutter": 20 },
    "mobile": { "frame": 390, "columns": 4, "margin": 16, "gutter": 12 }
  },
  "breakpoint": { "sm": 640, "md": 768, "lg": 1024, "xl": 1280, "2xl": 1536 },
  "motion": { "fast": "120ms", "base": "180ms", "slow": "260ms", "ease": "cubic-bezier(0.2, 0, 0, 1)" },
  "layout": { "maxWidth": 1344, "headerHeight": 64, "headerHeightMobile": 56, "drawerWidth": 440 }
}
