# ShaderPaper backend (Medusa). Copy to .env and fill in; .env is gitignored, never commit it.
# Values are empty on purpose: no secret or key belongs in this file.

# Postgres, e.g. postgres://shaderpaper:<password>@localhost:5432/shaderpaper
DATABASE_URL=
# Long random strings, e.g. `openssl rand -base64 32`
JWT_SECRET=
COOKIE_SECRET=

# Origins allowed to call the store API (the Nuxt storefront on :3000 in development), the admin and auth.
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:5173,http://localhost:9000
AUTH_CORS=http://localhost:5173,http://localhost:9000,http://localhost:3000

# Optional. Without it Medusa uses in-memory event bus, cache and locking (fine for development).
REDIS_URL=

# Poster print files: the print renderer service (apps/print-renderer) and its shared token
# (the same value as RENDERER_TOKEN in apps/print-renderer/.env), e.g. http://localhost:4000
PRINT_RENDERER_URL=
PRINT_RENDERER_TOKEN=

# Prodigi Print API (src/poster/prodigi.ts). Empty key = Prodigi off. Development uses a SANDBOX key
# with PRODIGI_ENV=sandbox; PRODIGI_ENV=live is refused unless NODE_ENV=production (live orders are
# printed, shipped and charged). Orders are only sent when an admin asks (POST /admin/orders/:id/prodigi).
PRODIGI_API_KEY=
PRODIGI_ENV=sandbox

# Optional: Stripe payments. Méridien (MapAndSky) does not wire Stripe in its backend (its region uses
# Medusa's system provider, which takes no payment); its storefront only shows Stripe's card form when a
# `pp_stripe_*` provider is on the region and NUXT_PUBLIC_STRIPE_KEY is set. Here, a secret key
# (sk_test_… in development) registers Medusa's Stripe provider (medusa-config.ts); the region then
# needs `pp_stripe_stripe` (added by the seed when this is set at seed time, or in the admin).
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=
