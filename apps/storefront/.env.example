# Copy to .env (gitignored) and fill in. Never commit real values.

# Medusa backend (server-only: the browser never talks to Medusa)
MEDUSA_BACKEND_URL=
# Publishable API key of the backend's sales channel (pk_…). Server-only too.
MEDUSA_PUBLISHABLE_KEY=

# Region routing: the /{countryCode} visitors land on when the URL has none
NUXT_PUBLIC_DEFAULT_REGION=
NUXT_PUBLIC_FALLBACK_REGION=

# Absolute origin of this storefront (canonical links, print render URLs)
NUXT_PUBLIC_BASE_URL=

# Stripe publishable key (pk_test_… in development). Empty = no card payments;
# the checkout then offers only the backend's manual provider and says
# "Test mode: no payment is taken".
NUXT_PUBLIC_STRIPE_KEY=
NUXT_PUBLIC_MEDUSA_PAYMENTS_PUBLISHABLE_KEY=
NUXT_PUBLIC_MEDUSA_PAYMENTS_ACCOUNT_ID=
