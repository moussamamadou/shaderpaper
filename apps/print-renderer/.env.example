# Shared secret: callers send `Authorization: Bearer <token>`. Required in production.
RENDERER_TOKEN=
PORT=4000
# Storefront serving the render page (/render?d=<design, base64url JSON>, see README.md).
STOREFRONT_URL=http://localhost:3000
RENDER_PATH=/render
# Browser: installed Chrome by default; CHROME_PATH points at any Chrome/Chromium binary.
# CHROME_CHANNEL=chrome
# CHROME_PATH=/usr/bin/chromium
# "swiftshader" (software WebGL, works everywhere, 8192 px max) or "gpu".
RENDER_GL=swiftshader
RENDER_CONCURRENCY=1
RENDER_QUEUE_LIMIT=10
RENDER_TIMEOUT_MS=120000
