{
  "name": "@shaderpaper/print-renderer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Renders ShaderPaper posters to print files: headless Chrome screenshots the storefront's /render page at print resolution.",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.ts",
    "start": "node --env-file-if-exists=.env src/server.ts",
    "render": "node --env-file-if-exists=.env src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
